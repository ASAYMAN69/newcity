# Google AI (Genkit) — powers the AI assistant / relocation planner
# (src/ai/genkit.ts  →  @genkit-ai/googleai plugin, gemini-2.5-flash)
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=

